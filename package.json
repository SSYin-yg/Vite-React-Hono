{
  "name": "minelink-cloudflare",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "predev": "node scripts/ensure-dist.mjs",
    "prebuild": "npm install --no-save --package-lock=false --include=optional @rollup/rollup-linux-x64-gnu@$(node -p \"require('rollup/package.json').version\")",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/web\"",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "npm run build && npm run preview --workspace apps/api",
    "admin:check": "node scripts/check-admin-env.mjs",
    "db:migrate:local": "npm run db:migrate:local --workspace apps/api",
    "db:seed:local": "npm run db:seed:local --workspace apps/api",
    "db:reset:local": "npm run db:reset:local --workspace apps/api",
    "deploy": "npm run build && npm run deploy --workspace apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
