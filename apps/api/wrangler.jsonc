{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minelink-b2b",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs：线上日志可在 Dashboard → Worker → Logs 直接查看，首次上线排错必备
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minelink-db",
      "database_id": "dd079fc1-6c86-41e4-b1fb-c0b8ad37fc67",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "minelink-images"
    }
  ],
  "vars": {
    "MAIL_FROM": "Minelink B2B <noreply@example.com>",
    "MAIL_TO": "sales@example.com",
    // 站点正式域名，用于 sitemap.xml / robots.txt 生成；上线前改成真实域名
    "SITE_URL": "https://minelink.example.com"
  },
  // secrets（不写在配置里，用 `wrangler secret put` 设置）：
  //   RESEND_API_KEY — Resend 邮件 API 密钥，缺省时询盘只落库不发信
  //   ADMIN_TOKEN    — /api/admin/* 的 Bearer 令牌
}
