{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minelink-b2b",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs：线上日志可在 Dashboard → Worker → Logs 直接查看，首次上线排错必备
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // 关键：让 Worker 在「所有请求（含 `/`、静态页）」之前运行，
    // 全局中间件才能对返回 HTML 注入 GSC 验证标签等 head 内容。
    // 未命中资产的请求仍按 not_found_handling 回落 SPA 的 index.html。
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minelink-db",
      "database_id": "dd079fc1-6c86-41e4-b1fb-c0b8ad37fc67",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "minelink-images"
    }
  ],
  "vars": {
    "MAIL_FROM": "Minelink B2B <noreply@example.com>",
    "MAIL_TO": "sales@example.com",
    // 站点正式域名，用于 sitemap.xml / robots.txt 生成；同时供 robots.txt / SSR canonical 使用
    "SITE_URL": "https://www.b2b.ssyin033.top"
  },
  // secrets（不写在配置里，用 `wrangler secret put` 设置）：
  //   RESEND_API_KEY — Resend 邮件 API 密钥，缺省时询盘只落库不发信
  //   ADMIN_TOKEN    — /api/admin/* 的 Bearer 令牌；生产环境必须使用高强度随机值
}
