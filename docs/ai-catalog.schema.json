{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.b2b-ssyin033.top/.well-known/ai-catalog.schema.json",
  "title": "Minelink AI Catalog",
  "description": "Machine-readable catalog and content discovery format for Minelink Equipment.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_name",
    "generated_at",
    "language",
    "site",
    "discovery",
    "pages",
    "categories",
    "products",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "schema_name": {
      "const": "Minelink AI Catalog"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "enum": [
        "zh",
        "en"
      ]
    },
    "site": {
      "type": "object",
      "required": [
        "name",
        "url",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "discovery": {
      "type": "object",
      "required": [
        "llms_txt",
        "sitemap",
        "robots",
        "current_catalog"
      ],
      "properties": {
        "llms_txt": {
          "type": "string",
          "format": "uri"
        },
        "sitemap": {
          "type": "string",
          "format": "uri"
        },
        "robots": {
          "type": "string",
          "format": "uri"
        },
        "current_catalog": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "title",
          "description",
          "format"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "format": {
            "type": "object",
            "required": [
              "html",
              "markdown"
            ],
            "properties": {
              "html": {
                "type": "string",
                "format": "uri"
              },
              "markdown": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "summary",
          "urls"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "category_name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "specifications": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "parameter",
                "value"
              ],
              "properties": {
                "parameter": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "model_tables": {
            "type": "array"
          },
          "urls": {
            "type": "object",
            "required": [
              "html",
              "markdown",
              "alternate_language"
            ],
            "properties": {
              "html": {
                "type": "string",
                "format": "uri"
              },
              "markdown": {
                "type": "string",
                "format": "uri"
              },
              "alternate_language": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "keywords": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "admin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "api": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
